# OpenAI API key used by the outreach and closer agents.
OPENAI_API_KEY=
# OpenAI model used by both agents.
MODEL_NAME=gpt-5.4-mini
# Optional HTTPS booking link the agents are instructed to include when proposing a call.
# BOOKING_LINK=https://cal.com/you/20min
# Resend API key used to send email.
RESEND_API_KEY=
# Verified Resend sender address; the default is for testing only.
RESEND_FROM=onboarding@resend.dev
# Gmail address that receives replies and authenticates IMAP.
EMAIL_ADDRESS=
# Gmail app password used for IMAP login.
EMAIL_APP_PASSWORD=
# Your test recipient, required while SEND_TO_SELF is true.
EMAIL_ADDRESS2=
# Route all outbound email to EMAIL_ADDRESS2; accepts true, 1, or yes.
SEND_TO_SELF=true
# Telegram bot token used for owner notifications.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID that receives owner notifications.
TELEGRAM_CHAT_ID=
# Set to 1 to disable OpenAI Agents SDK tracing uploads.
# OPENAI_AGENTS_DISABLE_TRACING=1
